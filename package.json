{
  "name": "octopus",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.26",
      "sharp": "^0.35.0"
    },
    "postcss": "^8.5.26",
    "sharp": "^0.35.0"
  },
  "scripts": {
    "dev": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint backend/src frontend/src --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture": "node scripts/check-architecture.mjs",
    "env:check": "node scripts/check-env.mjs",
    "security": "npm audit --omit=dev --audit-level=critical",
    "deps:outdated": "npm outdated || true",
    "migration:check": "node scripts/check-migrations.mjs",
    "graphify:extract": "graphify extract . --code-only",
    "graphify:update": "graphify update .",
    "graphify:query": "graphify query",
    "validate": "node scripts/validate.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
