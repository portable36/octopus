NODE_ENV=development
APP_NAME=multivendor-commerce
API_PORT=3000
WEB_PORT=3001
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commerce
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-secret-manager
JWT_REFRESH_SECRET=replace-with-secret-manager
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=30d

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=replace-with-secret-manager

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=commerce
S3_ACCESS_KEY_ID=replace
S3_SECRET_ACCESS_KEY=replace

SSLCOMMERZ_STORE_ID=replace
SSLCOMMERZ_STORE_PASSWORD=replace
BKASH_APP_KEY=replace
BKASH_APP_SECRET=replace
BKASH_USERNAME=replace
BKASH_PASSWORD=replace
NAGAD_MERCHANT_ID=replace
NAGAD_PUBLIC_KEY=replace
NAGAD_PRIVATE_KEY=replace

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=commerce-api

CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
