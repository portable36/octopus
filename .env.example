NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://octopus:octopus@localhost:5432/octopus
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey
SEARCH_PRODUCTS_INDEX=products

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=octopus-media
# Optional public CDN/base for thumbnails (defaults to S3_ENDPOINT/S3_BUCKET)
# MEDIA_PUBLIC_BASE_URL=http://localhost:9000/octopus-media

CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Online COD defaults (store/vendor settings override)
COD_DEFAULT_ENABLED=false
COD_MIN_AMOUNT_MINOR=0
# COD_MAX_AMOUNT_MINOR=
COD_RESERVATION_TTL_HOURS=72

# Courier (sandbox defaults; production uses per-vendor encrypted credentials)
# COURIER_CREDENTIALS_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# PATHAO_USERNAME=
# PATHAO_PASSWORD=
# PATHAO_STORE_ID=
COURIER_HTTP_TIMEOUT_MS=15000

# Phase 12 — transactional outbox dispatcher (BullMQ via Redis)
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_DISPATCH_RETRIES=10

# Phase 15 — vendor ledger settlement window (days until SALE/COMMISSION become available)
LEDGER_SETTLEMENT_DAYS=7

# Frontend (public — safe for browser bundles)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_NAME=Octopus
