{
  "name": "multivendor-commerce",
  "private": true,
  "scripts": {
    "validate": "bash ./scripts/validate.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:api && npm run lint:web",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "lint:api": "npm --workspace apps/api run lint",
    "lint:web": "npm --workspace apps/web run lint",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "architecture": "node scripts/check-architecture.mjs",
    "security": "npm audit --audit-level=high",
    "deps:outdated": "npm outdated",
    "db:migrate:check": "npm --workspace apps/api run db:migrate:check",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "dev": "docker compose up -d && npm run dev:apps",
    "dev:apps": "concurrently \"npm --workspace apps/api run start:dev\" \"npm --workspace apps/web run dev\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0",
    "vitest": "^4.1.11",
    "@playwright/test": "^1.0.0"
  }
}
