# Copy to the compose host as `/opt/octopus/host.secrets.env` (or next to
# docker-compose.prod.yml). Never commit real values. Compose loads this via
# `env_file` when present; missing file is OK for local matrix smoke tests.
#
# chmod 600 host.secrets.env

# --- required for real production ---
JWT_SECRET=
# Optional overlap during access-token key rotation:
# JWT_SECRET_PREVIOUS=

# Runtime app role (NOSUPERUSER / NOBYPASSRLS) — created by Migration20260920120000
DATABASE_URL=postgresql://octopus_app:CHANGE_ME_APP@postgres:5432/octopus
# Owner / migrator (DDL only)
DATABASE_OWNER_URL=postgresql://octopus:CHANGE_ME@postgres:5432/octopus
REDIS_URL=redis://redis:6379

CORS_ORIGINS=https://shop.example.com

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=octopus-media

# Storefront public URLs (also set as Actions vars when baking the image)
SEO_PUBLIC_SITE_URL=https://shop.example.com

# --- optional ---
# SENTRY_DSN=
# PAYMENT_IPN_HMAC_SECRET=  # required in production (≥16 chars)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWD=
# COURIER_CREDENTIALS_KEY=
# STEADFAST_WEBHOOK_SECRET=
# PATHAO_WEBHOOK_SECRET=

# Host health cron (deploy/install-health-cron.sh sources this file)
# API_BASE=https://api.example.com/api/v1
# STORE_BASE=https://shop.example.com
# PAGER_WEBHOOK_URL=https://hooks.slack.com/services/...
