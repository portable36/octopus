NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://octopus:octopus@localhost:5432/octopus
# Pool size — raise max only after observing wait/saturation (OTel db metrics / pg_stat)
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
# Warn when a SQL statement takes ≥ N ms (0 = off)
DATABASE_SLOW_QUERY_MS=500
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-random-32-plus-character-secret
# Optional previous secret during JWT rotation (verify-only overlap window)
# JWT_SECRET_PREVIOUS=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey
SEARCH_PRODUCTS_INDEX=products

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=octopus-media
# Optional public CDN/base for thumbnails (defaults to S3_ENDPOINT/S3_BUCKET)
# MEDIA_PUBLIC_BASE_URL=http://localhost:9000/octopus-media

CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# JSON/urlencoded body size (Nest bodyParser disabled; set in configureApplication)
HTTP_BODY_LIMIT=1mb

# Phase 23 — OpenTelemetry HTTP traces (opt-in; off by default)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=octopus-api
# Base URL; SDK appends /v1/traces and /v1/metrics
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Phase 23 — Sentry (opt-in; unset DSN = disabled)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=octopus@0.1.0
# Frontend also reads NEXT_PUBLIC_SENTRY_DSN (same project DSN is fine)
# NEXT_PUBLIC_SENTRY_DSN=

# Online COD defaults (store/vendor settings override)
COD_DEFAULT_ENABLED=false
COD_MIN_AMOUNT_MINOR=0
# COD_MAX_AMOUNT_MINOR=
COD_RESERVATION_TTL_HOURS=72

# Courier (sandbox defaults; production uses per-vendor encrypted credentials)
# COURIER_CREDENTIALS_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# PATHAO_USERNAME=
# PATHAO_PASSWORD=
# PATHAO_STORE_ID=
COURIER_HTTP_TIMEOUT_MS=15000
# Extra outbound hosts for SSRF allowlist (comma-separated). PATHAO/STEADFAST base URL hosts are always included.
# OUTBOUND_URL_ALLOWLIST=courier.pathao.com,portal.packzy.com

# Phase 12 — transactional outbox dispatcher (BullMQ via Redis)
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_DISPATCH_RETRIES=10
BULLMQ_JOB_TIMEOUT_MS=30000
BULLMQ_CONCURRENCY_DEFAULT=5
BULLMQ_CONCURRENCY_PAYOUT=3
BULLMQ_CONCURRENCY_SEARCH=3

# Phase 15 — vendor ledger settlement window (days until SALE/COMMISSION become available)
LEDGER_SETTLEMENT_DAYS=7

# Frontend (public — safe for browser bundles)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_NAME=Octopus
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional media CDN/base for next/image remotePatterns (defaults include localhost:9000 MinIO)
# NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/octopus-media
# Bundle report: ANALYZE=true npm run analyze -w frontend
